# Database
# IMPORTANT: POSTGRES_PASSWORD applies only on FIRST start (empty volume).
# If logs say "Skipping initialization", changing .env does NOT update the password.
# Fix: scripts/reset-db.sh  or  docker compose down -v
POSTGRES_USER=promptdb
POSTGRES_PASSWORD=promptdb-dev-secret
POSTGRES_DB=promptdb

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
ALLOW_REGISTRATION=true
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:5173
ENVIRONMENT=development
# ENVIRONMENT=production  → requires strong SECRET_KEY (≥32 chars) and CORS_ORIGINS
TRUST_PROXY_HEADERS=true

# Frontend ports (docker compose host mapping)
HTTP_PORT=80
HTTPS_PORT=443
SSL_CERT_DIR=./certs

# Docker Compose: API via nginx proxy (same-origin, no CORS needed)
VITE_API_URL=
API_UPSTREAM=http://backend:8000

# For a separate API domain (Kubernetes / GitHub release build):
# VITE_API_URL=https://api.prompt-db.example.com
# API_UPSTREAM=

# Production example:
# ENVIRONMENT=production
# ALLOW_REGISTRATION=true
# TRUST_PROXY_HEADERS=true
# SECRET_KEY=<output of: openssl rand -hex 32>
# CORS_ORIGINS=https://prompt-db.example.com

# Container images (production)
IMAGE_REGISTRY=ghcr.io/erlkoenig91
TAG=latest

# Local frontend development (npm run dev)
# VITE_API_URL=http://localhost:8000
